<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <!-- Transparent background -->
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>

        <!-- Force empty drawable (NO launcher icon fallback) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty</item>

        <!-- Remove branding image -->
        <item name="android:windowSplashScreenBrandingImage">@null</item>

    </style>

</resources>
